# Set in your shell, never put actual secrets in Git.
OZON_ENV_FILE=/absolute/path/outside/repository/ozon.env
PORT=4173

OZON_PERFORMANCE_ENV_FILE=/absolute/private/performance.env

# Local Ollama model. No API key needed.
OPS_QWEN_MODEL=qwen2.5:14b
# codex: retry weak extraction through the authenticated Codex CLI.
# review: save a review packet without an automatic Codex request.
OPS_PAGE_FALLBACK=codex
